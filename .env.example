# Public values used by the browser and SSR session client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# One-time bootstrap command. Remove after creating the initial owner.
KAIROS_BOOTSTRAP_CONFIRM=
KAIROS_ADMIN_EMAIL=
KAIROS_ADMIN_NAME=
KAIROS_ORGANIZATION_NAME=Salón de Recepciones Kairós
